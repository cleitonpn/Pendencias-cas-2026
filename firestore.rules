rules_version = '2';

// ── Modelo de segurança ────────────────────────────────────────────────────
//
// O Firebase Auth dá uma identidade anônima a cada cliente; as regras usam
// isso apenas para rejeitar requisições vindas de fora do app. O controle de
// quem é quem continua no PIN — mas o PIN não mora mais no cliente.
//
// As coleções listadas em isProtected() estão fechadas para qualquer cliente.
// Elas são lidas e escritas somente pelo Admin SDK, dentro das Cloud
// Functions:
//
//   listUsers    → nomes de um papel, sem PIN (tela de login)
//   verifyPin    → confere o PIN digitado (o cadastrado nunca desce)
//   adminGate    → portão de administrador, devolve um token de sessão
//   manageUsers  → gestão de usuários e PINs, exige sessão de administrador
//   adminLogout / cleanupAdminSessions → encerram as sessões
//
// Antes desta versão a regra geral (`allow read, write: if request.auth
// != null`) valia também para as coleções de PIN, e a sessão anônima dos
// portais públicos — o do stand, o da organizadora — bastava para baixar
// todos os PINs do sistema.
//
// As regras do Firestore são somadas com OU: não dá para restringir uma
// coleção acrescentando um `match` mais específico, porque o `match` genérico
// continuaria autorizando. Por isso o curinga abaixo é `{col}/{doc}` (um
// nível) com as coleções protegidas excluídas, em vez de `{document=**}`.
// Não há subcoleções em uso.
// ──────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isProtected(col) {
      return col in [
        'producer_pins',
        'consultant_pins',
        'manager_pins',
        'team_leader_pins',
        'analyst_pins',
        'organizer_pins',
        'admin_users',
        'logistics_users',
        'admin_sessions',
        'pin_attempts'
      ];
    }

    // Lidas por todos, escritas só pelo Admin SDK dentro das funções.
    //
    // app_config guarda a versão mínima do app. Se o cliente pudesse
    // escrever, qualquer sessão autenticada — inclusive a anônima dos portais
    // públicos — poderia exigir uma versão que não existe e trancar a equipe
    // inteira fora do app no meio de uma montagem.
    function isServerOwned(col) {
      return col in ['app_config', 'cv_status'];
    }

    match /{col}/{doc} {
      allow read: if request.auth != null && !isProtected(col);
      allow write: if request.auth != null &&
                      !isProtected(col) &&
                      !isServerOwned(col);
    }
  }
}
